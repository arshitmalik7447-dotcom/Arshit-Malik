# GEMINI_API_KEY: Optional. Used for the replaceable server-side conversational AI adapter.
# If unset, the assistant gracefully falls back to the deterministic, grounded knowledge retriever.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted (e.g., https://your-backend.example.com).
# In AI Studio, this is automatically injected at runtime.
APP_URL="http://localhost:3000"

# ADMIN_API_KEY: Secret key required to access the protected administration screen and API.
ADMIN_API_KEY="tiona-admin-secret-2026"

# Fixed lead notification recipient (cannot be altered by visitor chat input or API payload)
LEAD_NOTIFICATION_EMAIL="arshitmalik@tionasilver.com"

# SMTP Configuration (Optional during local development / testing).
# If omitted, the server uses an in-memory / JSON test outbox transport that logs delivery status.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Tiona Assistant <no-reply@tionasilver.com>"

# DATABASE_URL: Optional PostgreSQL connection string (e.g. postgres://user:pass@host:5432/tionadb).
# If not provided, the server runs embedded PostgreSQL engine (@electric-sql/pglite) with persistent disk storage.
DATABASE_URL=""

